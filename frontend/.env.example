# Base URL for the Laravel REST API (no trailing slash).
# Defaults to "/api" which is proxied to the backend by the Vite dev server.
VITE_API_URL=/api

# Optional: override the backend host used by the Vite dev-server proxy.
# Only needed when the backend isn't reachable at the default localhost:8000.
VITE_PROXY_TARGET=http://localhost:8000
